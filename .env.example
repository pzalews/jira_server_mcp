# Jira Server / Data Center connection (NOT Jira Cloud)
JIRA_URL=https://jira.internal.example.com

# Authentication: PAT (Personal Access Token) takes priority over username+password
JIRA_TOKEN=your-personal-access-token-here
# JIRA_USERNAME=your-username
# JIRA_PASSWORD=your-password

# Optional settings
JIRA_DEFAULT_PROJECT=PROJ
JIRA_READ_ONLY=false
JIRA_LOG_PATH=./jira-mcp.log

# Custom proxy/Zero Trust headers (comma-separated KEY=VALUE pairs)
# JIRA_CUSTOM_HEADERS=X-Forwarded-User=alice,X-Proxy-Auth=internal

# MCP Transport: stdio (default) | http | streamable-http
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000

# For docker-compose with two Jira servers:
# JIRA1_URL=https://jira1.internal.example.com
# JIRA1_TOKEN=token-for-jira1
# JIRA2_URL=https://jira2.internal.example.com
# JIRA2_TOKEN=token-for-jira2
